[package]
title = "FindSurface UIApp Debug Validation Baseline"
version = "1.0.0"
description = "Minimal Kit UI app with renderer debug validation enabled and no FindSurface extension."

[settings]
app.name = "FindSurface"
app.version = "1.0.0"
app.window.title = "FindSurface UIApp Debug Validation Baseline"
app.window.width = 1600
app.window.height = 900
app.fastShutdown = false
renderer.debug.validation.enabled = true

[dependencies]
"omni.kit.uiapp" = {}
